# Public values only. Vite exposes every VITE_ variable to the browser.
# Copy this file to .env.local and fill in the anon key from
# Supabase Dashboard → Project Settings → API → anon public.
# Never put the service_role key, a secret key, or a database password here.

VITE_SUPABASE_URL=https://ptjtiexrgwjomvaefouo.supabase.co
VITE_SUPABASE_ANON_KEY=

# Keep unset on https://admin.alimanrouh.com.
# The customer portal is enabled automatically during `npm run dev`.
# Set this to true only for a temporary integration test build.
VITE_ENABLE_CUSTOMER_PORTAL=
